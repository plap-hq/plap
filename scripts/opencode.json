{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "plap": {
      "npm": "@plap/ai-sdk",
      "name": "plap",
      "models": {
        "plap-ai/wisp": {
          "name": "Wisp",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "variants": {
            "minimal": {
              "reasoningEffort": "minimal",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "input": 1000000,
            "output": 1000000
          }
        },
        "plap-ai/mote": {
          "name": "Mote",
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "variants": {
            "minimal": {
              "reasoningEffort": "minimal",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "input": 1000000,
            "output": 1000000
          }
        }
      }
    }
  },
  "plugin": [
    "cc-safety-net@latest"
  ],
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/*": "allow"
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  }
}
