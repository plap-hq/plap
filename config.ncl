(import "schema.ncl") & {
  display_name | default = "plap-ai",
  model_info | default = {
    display_name = "plap-ai",
    description = "plap responses model",
    mode = "responses",
    input_modalities = ["text"],
    output_modalities = ["text"],
    max_input_tokens = 1000000,
    max_output_tokens = 1000000,
    supported_parameters = [
      "context_management",
      "temperature",
      "top_p",
      "tools",
      "tool_choice",
      "parallel_tool_calls",
      "response_format",
      "max_output_tokens",
      "reasoning_effort",
      "service_tier",
      "stream",
    ],
    pricing = {
      input_per_token = 0.0,
      output_per_token = 0.0,
    },
    provider = "plap",
    deprecated = false,
  },
  default_reasoning_effort | default = 'medium,
  main | default = {
    model = "crof/mimo-v2.5-pro,openrouter/xiaomi/mimo-v2.5-pro:xiaomi,gmicloud/XiaomiMiMo/MiMo-V2.5-Pro",
    max_completion_tokens = 131072,
    reasoning_effort = 'medium,
  },
  compactor | default = {
    model = "crof/mimo-v2.5-pro,openrouter/xiaomi/mimo-v2.5-pro:xiaomi,gmicloud/XiaomiMiMo/MiMo-V2.5-Pro",
    max_completion_tokens = 131072,
    reasoning_effort = 'high,
  },
  defender | default = {
    model = "crof/mimo-v2.5-pro,openrouter/xiaomi/mimo-v2.5-pro:xiaomi,gmicloud/XiaomiMiMo/MiMo-V2.5-Pro",
  },
  reviewer | default = {
    model = "crof/mimo-v2.5-pro,openrouter/xiaomi/mimo-v2.5-pro:xiaomi,gmicloud/XiaomiMiMo/MiMo-V2.5-Pro",
  },
  arbitrator | default = {
    model = "crof/mimo-v2.5-pro,openrouter/xiaomi/mimo-v2.5-pro:xiaomi,gmicloud/XiaomiMiMo/MiMo-V2.5-Pro",
  },
  reasoning_summarizer | default = {
    model = "groq/openai/gpt-oss-20b,lightning/lightning-ai/gpt-oss-20b,openrouter/openai/gpt-oss-20b:wandb,openrouter/openai/gpt-oss-20b:amazon-bedrock",
  },
  reviewer_max_transcript_tokens | default = 256000,
  arbitrator_max_transcript_tokens | default = 256000,
  compact_threshold | default = 256000,
  compact_max_rounds | default = 0,
  debate_max_rounds | default = 2,
  reasoning_to_output | default = 1.0,
  by_reasoning_effort | default = {
    minimal = {
      main.reasoning_effort = 'none,
      defender.reasoning_effort = 'none,
      reviewer.reasoning_effort = 'none,
      arbitrator.reasoning_effort = 'none,
    },
    low = {
      main.reasoning_effort = 'low,
      defender.reasoning_effort = 'low,
      reviewer.reasoning_effort = 'low,
      arbitrator.reasoning_effort = 'low,
    },
    medium = {
      main.reasoning_effort = 'medium,
      defender.reasoning_effort = 'medium,
      reviewer.reasoning_effort = 'medium,
      arbitrator.reasoning_effort = 'medium,
    },
    high = {
      main.reasoning_effort = 'high,
      defender.reasoning_effort = 'high,
      reviewer.reasoning_effort = 'high,
      arbitrator.reasoning_effort = 'high,
    },
    xhigh = {
      main.reasoning_effort = 'xhigh,
      defender.reasoning_effort = 'xhigh,
      reviewer.reasoning_effort = 'xhigh,
      arbitrator.reasoning_effort = 'xhigh,
    },
  },
  by_model."plap-ai/wisp" = {
    display_name = "Wisp",
    model_info.display_name = "Wisp",
    model_info.description = "General-purpose high-efficiency model optimized for balanced performance.",
    main.model = "crof/mimo-v2.5-pro,openrouter/xiaomi/mimo-v2.5-pro:xiaomi,gmicloud/XiaomiMiMo/MiMo-V2.5-Pro",
    main.max_completion_tokens = 131072,
    compactor.reasoning_effort = 'high,
  },
  by_model."plap-ai/wisp-mini" = {
    display_name = "Wisp Mini",
    model_info.display_name = "Wisp Mini",
    model_info.description = "General-purpose plap responses model for text and tool use.",
